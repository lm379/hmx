# --- Server Config ---
GIN_MODE=release      # (debug 或 release)
SERVER_PORT=15379

# --- Database (Postgres or Supabase) ---
DB_USER="postgres"
DB_PASSWORD="your_password"
DB_ADDRESS="localhost"
DB_PORT=5432
DB_NAME="postgres"

# --- Redis ---
REDIS_ADDR="localhost:6379"
REDIS_PASSWORD=""
REDIS_DB=0

# --- SMTP Email Config ---
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=user@example.com
SMTP_PASS=your-email-password
SMTP_CODE_EXPIRES=10  # 验证码过期时间（分钟）

# --- JWT Config ---
JWT_SECRET_KEY="your-super-secret-key-for-jwt"
JWT_ACCESS_TOKEN_EXPIRES_IN=15m   # Access Token 过期时间
JWT_REFRESH_TOKEN_EXPIRES_IN=168h # Refresh Token 过期时间

# --- S3 Compatible Storage ---
S3_ENDPOINT="https://s3.your-cloud-provider.com"
S3_REGION="your-region"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="your-hmx-bucket"
S3_PRESIGN_EXPIRES_IN_MINUTES=15m
# 自定义域名 (可选)
# S3_CUSTOM_DOMAIN="https://cdn.yourdomain.com"

# --- AI Service Config ---
# 注意：请替换为你自己的API Key和模型名称
# 项目采用标准OpenAI接口规范，支持多种兼容OpenAI接口的服务提供商
# Embedding服务
EMBEDDING_API_KEY=your_siliconflow_api_key_here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# 视频字幕摘要服务
SUBTITLE_API_KEY=your_subtitle_api_key_here
SUBTITLE_BASE_URL=https://api.siliconflow.cn/v1
SUBTITLE_MODEL=deepseek-ai/DeepSeek-V3.2

# --- Meilisearch Config ---
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=